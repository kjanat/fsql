// Folder-specific settings
// vim: set ft=jsonc:
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
//
// mkdir -p .zed; curl -fsSLo .zed/settings.json https://github.com/kjanat/kjanat/raw/HEAD/.zed/settings.json
{
	"formatter": [
		{
			"external": {
				"command": "dprint",
				"arguments": ["fmt", "--stdin", "{buffer_path}"]
			}
		}
	],
	"prettier": { "allowed": false },
	"lsp": {
		"json-language-server": {
			"binary": {
				"path": "/usr/bin/vscode-json-language-server",
				"arguments": ["--stdio"],
				"env": { "VOLTA_BYPASS": "1" },
			},
			"settings": {
				"json": {
					"schemas": [
						{
							"fileMatch": ["tree-sitter.json"],
							"url": "https://raw.githubusercontent.com/tree-sitter/tree-sitter/refs/heads/master/docs/src/assets/schemas/config.schema.json"
						},
						{
							"fileMatch": ["dprint.json", "dprint.jsonc", ".dprint.json", ".dprint.jsonc"],
							"url": "https://dprint.dev/schemas/v0.json"
						},
						{
							"fileMatch": [".markdownlint.json", "markdownlint.json", ".markdownlint.jsonc", "markdownlint.jsonc"],
							"url": "https://cdn.jsdelivr.net/gh/DavidAnson/markdownlint/schema/markdownlint-config-schema.json"
						}
					]
				}
			}
		}
	}
}
