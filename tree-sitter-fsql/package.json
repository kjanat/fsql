{
	"name": "@kjanat/tree-sitter-fsql",
	"version": "0.1.0",
	"private": true,
	"description": "Tree-sitter grammar for fsql query files",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#grammar/*": "./grammar/*.js"
	},
	"exports": {
		"./package.json": "./package.json",
		"./tree-sitter.json": "./tree-sitter.json",
		"./grammar": "./grammar.js",
		"./grammar/*": "./grammar/*"
	},
	"files": [
		"/grammar.js",
		"/tree-sitter.json",
		"/grammar/**",
		"/queries/*",
		"/scripts/*",
		"/src/**",
		"*.wasm"
	],
	"scripts": {
		"check": "node scripts/check-examples.mjs",
		"generate": "tree-sitter generate",
		"test": "tree-sitter test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"biome": "catalog:",
		"tree-sitter": "catalog:",
		"tree-sitter-cli": "catalog:",
		"typescript": "catalog:"
	}
}
