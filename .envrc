current_shell=$(ps -p $$ -o comm=)
if [[ "$current_shell" == "zsh" ]]; then
	#shellcheck disable=SC1090
	source <(tree-sitter complete --shell zsh)
elif [[ "$current_shell" == "bash" ]]; then
	#shellcheck disable=SC1090
	source <(tree-sitter complete --shell bash)
else
	echo "source the completions yourself... possible shells: tree-sitter complete --shell [bash|elvish|fish|power-shell|zsh|nushell]"
fi

PATH_add bin
